# Salin file ini ke .env dan isi nilainya.
# Jangan commit .env ke repository.

# Koneksi PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://lebihjauh:GANTI_PASSWORD@localhost:5432/lebihjauh

# Secret untuk Better Auth — minimal 32 karakter acak
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=GANTI_SECRET_MINIMAL_32_KARAKTER

# URL origin aplikasi (tanpa trailing slash)
# Development: http://localhost:4321
# Production: https://domain.anda
BETTER_AUTH_URL=http://localhost:4321

# Origin tambahan yang boleh login (pisahkan dengan koma, sesuaikan IP dan port).
# Jangan gunakan wildcard untuk jaringan LAN. Restart server setelah perubahan.
# BETTER_AUTH_TRUSTED_ORIGINS=http://172.21.0.1:4321,http://127.0.0.1:4321

# Cloudflare R2 — media foto trip. Semua credential hanya untuk server, jangan gunakan PUBLIC_ prefix.
# Buat token S3 API yang dibatasi hanya ke satu bucket dan beri Object Read & Write.
R2_ACCOUNT_ID=GANTI_DENGAN_ACCOUNT_ID
R2_ACCESS_KEY_ID=GANTI_DENGAN_S3_ACCESS_KEY
R2_SECRET_ACCESS_KEY=GANTI_DENGAN_S3_SECRET_KEY
R2_BUCKET_NAME=lebihjauh-media
# Custom domain yang sudah terhubung ke bucket, tanpa slash penutup.
R2_PUBLIC_BASE_URL=https://media.domain-anda.com
# Bucket terpisah tanpa custom domain publik untuk bukti pembayaran dan bukti
# biaya operasional. Admin saja yang dapat membuka bukti lewat tautan sementara.
R2_PAYMENT_PROOF_BUCKET_NAME=lebihjauh-payment-proofs-private
# Bucket terpisah tanpa custom domain publik untuk foto identitas peserta.
# Jangan memakai bucket media publik atau bucket bukti pembayaran.
R2_PARTICIPANT_DOCUMENT_BUCKET_NAME=lebihjauh-participant-documents-private
# Origin admin yang dicek oleh `npm run test:r2`; default mengambil origin pertama auth.
# R2_CORS_TEST_ORIGIN=http://172.21.0.1:4321

# Booking Open Trip — 32 byte acak dalam heksadesimal. Dipakai untuk mengenkripsi
# NIK di database dan membuat hash pencegah duplikasi. Jangan pernah diganti saat
# data booking masih aktif, kecuali lewat prosedur rotasi kunci.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOKING_DATA_ENCRYPTION_KEY=GANTI_DENGAN_64_KARAKTER_HEX
# Nomor WhatsApp operasional dengan kode negara, hanya angka. Bila kosong, tombol
# tindak lanjut WhatsApp tidak ditampilkan pada invoice.
# BOOKING_WHATSAPP_NUMBER=6281234567890

# Metode pembayaran bisnis (bank, e-wallet, QRIS) dikelola admin di
# /admin/payments/methods agar dapat diubah tanpa menyimpan rekening di .env.

# Port aplikasi (opsional, default 4321 untuk dev)
# PORT=4321
