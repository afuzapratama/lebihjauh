{
  "name": "lebihjauh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test:e2e": "playwright test",
    "test:a11y": "npm run build && playwright test tests/accessibility.spec.ts",
    "test:admin-ui": "npm run build && node scripts/test-admin-ui.mjs",
    "test:phase-4i": "node --env-file=.env --import=tsx/esm scripts/test-phase-4i.ts",
    "test:phase-4j-1": "node --env-file=.env --import=tsx/esm scripts/test-phase-4j-1.ts",
    "test:phase-4j-2": "node --env-file=.env --import=tsx/esm scripts/test-phase-4j-2.ts",
    "test:departure-editor": "node --experimental-test-module-mocks --import=tsx/esm scripts/test-departure-editor.mjs",
    "test:phase-4j-ui": "node scripts/test-phase-4j-ui.mjs",
    "test:phase-4k": "node --env-file=.env --import=tsx/esm scripts/test-phase-4k.ts",
    "test:phase-4l": "node --env-file=.env --import=tsx/esm scripts/test-phase-4l.ts",
    "test:r2": "node --env-file=.env --import=tsx/esm scripts/test-r2.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "booking:expire": "node --env-file=.env --import=tsx/esm scripts/expire-booking-holds.ts",
    "bootstrap-admin": "node --env-file=.env --import=tsx/esm scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/caveat": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "astro": "^7.3.2",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^6.10.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.13.4",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
