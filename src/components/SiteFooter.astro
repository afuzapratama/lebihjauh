---
import Icon from './Icon.astro';
import SocialIcon from './SocialIcon.astro';
import Wordmark from './Wordmark.astro';
import type { SocialIconName } from '../lib/social-platforms';

const year = new Date().getFullYear();
interface Props {
  socialLinks?: Array<{
    key: SocialIconName;
    label: string;
    href: string;
  }>;
}
const { socialLinks = [] } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-main section">
    <div class="footer-brand">
      <Wordmark footer href="/" />
      <div class="footer-brand-copy">
        <p>
          Rasa penasaran yang sama.
          <br />
          Tujuan yang berbeda. Cerita yang baru.
        </p>
        {socialLinks.length > 0 && (
          <nav class="footer-socials" aria-label="Media sosial LebihJauh">
            {socialLinks.map(({ key, label, href }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${label} LebihJauh (buka di tab baru)`}
                title={label}
              >
                <SocialIcon name={key} size={18} />
              </a>
            ))}
          </nav>
        )}
      </div>
    </div>
    <div class="footer-links">
      <span>JELAJAH</span>
      <a href="/trip">Open Trip</a>
      <a href="/private-trip">Private Trip</a>
      <a href="/cek-booking">Cek Booking</a>
      <a href="/#galeri">Galeri</a>
    </div>
    <div class="footer-links">
      <span>LEBIH DEKAT</span>
      <a href="/about">Tentang LebihJauh</a>
      <a href="/#news">News & Cerita</a>
      <a href="/private-trip">
        Rencanakan perjalanan <Icon name="arrow-up" size={14} />
      </a>
    </div>
    <div class="footer-tagline">
      More people.
      <br />
      Farther places.
      <span>
        <Icon name="arrow-up" />
      </span>
    </div>
  </div>
  <div class="footer-bottom section">
    <span>© {year} LebihJauh. Go further.</span>
    <span>
      INDONESIA & BEYOND{' '}
      <span class="footer-star" aria-hidden="true">
        <Icon name="asterisk" size={20} />
      </span>
    </span>
  </div>
</footer>
