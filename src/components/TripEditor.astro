        throw new Error('Lengkapi tanggal dan jam terlebih dahulu.');
      return new Date(`${date}T${time}:00+07:00`).toISOString();
    }
    function departurePayload(form) {
      const data = Object.fromEntries(new FormData(form).entries());
      data.useItineraryOverride = scheduleItineraryToggle.checked;
      data.itineraryOverride = JSON.stringify(scheduleItineraryStages);
      data.useLatestTripVersion = form.elements.useLatestTripVersion.checked;
      for (const [serverName, [dateName, timeName]] of Object.entries(
        departureDateParts,
      )) {
        data[serverName] = isoFromWib(
          data[dateName],
          data[timeName],
          serverName !== 'balanceDueAt',
        );
        delete data[dateName];
        delete data[timeName];
      }
      if (new Date(data.endAt) <= new Date(data.startAt))
        throw new Error('Waktu selesai harus setelah waktu mulai.');
      if (new Date(data.bookingCutoffAt) > new Date(data.startAt))
        throw new Error('Tutup booking tidak boleh setelah keberangkatan.');
      if (
        data.balanceDueAt &&
        wibParts(data.balanceDueAt).date > wibParts(data.endAt).date
      )
        throw new Error(
          'Pelunasan tidak boleh setelah hari terakhir trip (hari turun).',
