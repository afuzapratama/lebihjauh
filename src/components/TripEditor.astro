      const signed = await save('/api/admin/media/presign', 'POST', {
        fileName: selectedCoverFile.name,
        contentType: selectedCoverFile.type,
        size: selectedCoverFile.size,
      });
      const response = await fetch(signed.uploadUrl, {
        method: 'PUT',
        headers: { 'Content-Type': signed.contentType },
        body: selectedCoverFile,
      });
      if (!response.ok)
        throw new Error(
          'Upload foto gagal. Periksa konfigurasi R2 lalu coba lagi.',
        );
      uploadedCover = { file: selectedCoverFile, publicUrl: signed.publicUrl };
      tripForm.elements.coverImageUrl.value = signed.publicUrl;
      if (previewObjectUrl) {
        URL.revokeObjectURL(previewObjectUrl);
