        departureForm.elements.startTime.value = '08:00';
      if (endIsAutomatic || !departureForm.elements.endDate.value)
        applyDuration(selectedDurationDays);
      if (cutoffIsAutomatic || !departureForm.elements.bookingCutoffDate.value)
        applyCutoff(1);
