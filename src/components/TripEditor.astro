              maxLength: 80,
              placeholder: 'Contoh: Hari 1',
            },
            null,
            index,
          ),
          stageField(
            'Judul perjalanan hari ini',
            'title',
            stage.title,
            {
              maxLength: 80,
              required: true,
              placeholder: 'Contoh: Basecamp → Puncak Ungaran',
