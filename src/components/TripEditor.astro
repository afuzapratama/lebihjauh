---
import FileUploadControl from './FileUploadControl.astro';

interface Props {
  tripId?: string;
}
const { tripId } = Astro.props;
---

<div id="trip-editor" data-trip-id={tripId ?? ''}>
  <div class="page-title">
    <div>
      <p class="eyebrow">01 / {tripId ? 'KELOLA PAKET' : 'PAKET BARU'}</p>
      <h1 id="package-page-title">{tripId ? 'Memuat paket…' : 'Buat trip.'}</h1>
      {tripId && (
        <p class="page-lead">
          Kelola keberangkatan, atau pilih bagian paket yang ingin diubah.
        </p>
      )}
    </div>
    <div class="page-title-actions">
      <a id="public-trip-link" class="link-button" href="/trip" hidden>
        Lihat halaman publik ↗
      </a>
      <a class="link-button" href="/admin/trips">
        ← Daftar trip
      </a>
    </div>
  </div>
  <p class="notice" id="notice" hidden role="status"></p>

  {tripId && (
    <nav
      class="package-tabs"
      role="tablist"
      aria-label="Bagian pengelolaan open trip"
    >
      <button
        type="button"
        role="tab"
        id="tab-schedules"
        aria-controls="schedule-list-panel"
        aria-selected="true"
        data-package-tab="schedules"
      >
        Jadwal
      </button>
      <button
        type="button"
        role="tab"
        id="tab-package"
        aria-controls="package-editor"
        aria-selected="false"
        tabindex="-1"
        data-package-tab="package"
      >
        Data paket
      </button>
      <button
        type="button"
        role="tab"
        id="tab-pickups"
        aria-controls="pickup-master-editor"
        aria-selected="false"
        tabindex="-1"
        data-package-tab="pickups"
      >
        Titik jemput
      </button>
    </nav>
  )}

  <div class:list={['trip-editor-layout', { 'editor-layout-single': !tripId }]}>
    <section
      class="panel package-editor-panel"
      aria-labelledby="trip-form-title"
      id="package-editor"
      hidden={!!tripId}
    >
      <div class="panel-head">
        <div>
          <p class="eyebrow">01 / DATA PAKET</p>
          <h2 id="trip-form-title">Buat trip</h2>
        </div>
      </div>
      <p class="muted">
        Mulai dari ceritanya. Lengkapi paket yang akan dibaca calon peserta.
      </p>
      <form id="trip-form">
        <input type="hidden" name="id" />
        <input type="hidden" name="slug" />
        <input type="hidden" name="coverImageUrl" />
        <!-- Kompatibilitas teks lama; lokasi baru memakai katalog titik jemput. -->
        <input type="hidden" name="meetingPoint" />
        <details open>
          <summary>01 · Informasi utama</summary>
          <div class="package-main-fields">
            <label>
              Nama trip{' '}
              <input
                name="name"
                maxlength="120"
                required
                placeholder="Labuan Bajo Sailing"
              />
            </label>
            <div class="generated-slug" aria-live="polite">
              <span>URL otomatis</span>
              <output id="slug-preview">/trip/—</output>
            </div>
            <label>
              Jenis trip{' '}
              <select name="category" id="trip-category" required>
                <option value="">Pilih jenis trip</option>
                <option value="Petualangan & Pendakian">
                  Petualangan & Pendakian
                </option>
                <option value="Bahari & Sailing">Bahari & Sailing</option>
                <option value="Camping & Glamping">Camping & Glamping</option>
                <option value="Overland & Road Trip">
                  Overland & Road Trip
                </option>
                <option value="Budaya & Sejarah">Budaya & Sejarah</option>
                <option value="Ekowisata">Ekowisata</option>
                <option value="Wellness & Retreat">Wellness & Retreat</option>
                <option value="Keluarga & Edukasi">Keluarga & Edukasi</option>
                <option value="__custom">Lainnya — tulis sendiri</option>
              </select>
            </label>
            <label id="custom-category-field" hidden>
              Jenis trip kustom{' '}
              <input
                name="customCategory"
                maxlength="60"
                placeholder="Contoh: Fotografi alam"
              />
            </label>
            <label>
              Label lokasi <small>Opsional</small>
              <input
                name="locationLabel"
                maxlength="80"
                placeholder="Contoh: Bandung · Jawa Barat"
              />
              <small class="field-note">
                Tampil pada foto kartu katalog. Kosongkan untuk menyembunyikan
                label tanpa mengganggu trip lama.
              </small>
            </label>
            <div class="cover-field">
              <span class="form-label">Foto utama</span>
              <div class="cover-upload">
                <FileUploadControl
                  id="cover-file"
                  title="Unggah foto utama trip"
                  hint="Foto landscape · JPEG, PNG, atau WebP · maksimal 8 MB"
                  accept="image/jpeg,image/png,image/webp"
                  icon="photo"
                  size="large"
                  actionLabel="Pilih foto"
                />
                <div class="cover-preview" id="cover-preview" hidden>
                  <img
                    id="cover-preview-image"
                    alt="Pratinjau foto utama trip"
                  />
                  <div>
                    <strong id="cover-preview-name"></strong>
                    <span id="cover-preview-size"></span>
                    <button type="button" class="link-button" id="remove-cover">
                      Hapus foto
                    </button>
                  </div>
                </div>
              </div>
              <small class="field-note">
                Foto akan diunggah saat trip disimpan.
              </small>
            </div>
            <label>
              Tentang trip{' '}
              <textarea
                name="description"
                required
                maxlength="12000"
                rows="5"
              ></textarea>
            </label>
          </div>
        </details>
        <details>
          <summary>02 · Info trek &amp; tingkat aktivitas</summary>
          <p class="field-note activity-profile-intro">
            Bantu peserta menilai kecocokan perjalanan sebelum booking. Semua
            field opsional dan hanya tampil di halaman publik bila terisi.
          </p>
          <div class="trip-activity-fields">
            <label>
              Tingkat aktivitas
              <select name="difficultyLevel">
                <option value="">Belum ditentukan</option>
                <option value="beginner">Beginner — ramah pemula</option>
                <option value="intermediate">
                  Intermediate — perlu kebugaran dasar
                </option>
                <option value="advanced">Advanced — perlu pengalaman</option>
                <option value="expert">Expert — medan teknis/khusus</option>
              </select>
            </label>
            <label>
              Ketinggian destinasi <small>mdpl</small>
              <input
                name="elevationMeters"
                type="number"
                min="1"
                max="10000"
                step="1"
                placeholder="2050"
              />
            </label>
            <label>
              Jarak trek <small>km</small>
              <input
                name="trailDistanceKm"
                type="number"
                min="0.01"
                max="1000"
                step="0.01"
                placeholder="8.5"
              />
            </label>
            <label>
              Total kenaikan elevasi <small>meter</small>
              <input
                name="elevationGainMeters"
                type="number"
                min="0"
                max="20000"
                step="1"
                placeholder="750"
              />
            </label>
            <label>
              Durasi trek minimal <small>jam</small>
              <input
                name="trekDurationMinHours"
                type="number"
                min="0.5"
                max="168"
                step="0.5"
                placeholder="4"
              />
            </label>
            <label>
              Durasi trek maksimal <small>jam</small>
              <input
                name="trekDurationMaxHours"
                type="number"
                min="0.5"
                max="168"
                step="0.5"
                placeholder="5"
              />
            </label>
            <label>
              Nama jalur/rute
              <input
                name="routeName"
                maxlength="120"
                placeholder="Contoh: Via Mawar"
              />
            </label>
            <label class="activity-terrain-field">
              Karakter medan
              <textarea
                name="terrainSummary"
                maxlength="500"
                rows="3"
                placeholder="Contoh: Jalur tanah dan akar, beberapa tanjakan berbatu tanpa bagian teknis."
              ></textarea>
            </label>
            <div class="activity-map-field">
              <label for="trail-map-embed-url">
                Peta jalur pendakian <small>Opsional</small>
              </label>
              <textarea
                id="trail-map-embed-url"
                name="trailMapEmbedUrl"
                maxlength="4000"
                rows="3"
                placeholder="Tempel URL atau kode iframe dari uMap"
              ></textarea>
              <small class="field-note">
                Rekomendasi: unggah GPX ke{' '}
                <a
                  href="https://umap.openstreetmap.fr/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  uMap ↗
                </a>
                , publikasikan, lalu salin kode <em>Embed the map</em>. Google
                My Maps juga didukung. Kosongkan bila trip tidak membutuhkan
                peta jalur.
              </small>
            </div>
          </div>
          <p class="field-note difficulty-guidance">
            Beginner: jalur jelas dan nonteknis · Intermediate: ada bagian
            curam/tidak rata · Advanced: panjang, curam, atau berbatu · Expert:
            membutuhkan kemampuan teknis, navigasi, atau perlengkapan khusus.
          </p>
        </details>
        <details>
          <summary>03 · Fasilitas paket</summary>
          <label>
            Termasuk{' '}
            <textarea
              name="included"
              maxlength="12000"
              rows="3"
              placeholder="Satu item per baris"
            ></textarea>
          </label>
          <label>
            Tidak termasuk{' '}
            <textarea name="excluded" maxlength="12000" rows="3"></textarea>
          </label>
        </details>
        <details>
          {/* 4J: label diperbarui — itinerary ini adalah itinerary inti paket */}
          <summary>04 · Itinerary inti perjalanan</summary>
          <input name="itineraryStages" type="hidden" value="[]" />
          <div class="itinerary-editor" aria-labelledby="itinerary-title">
            <div class="itinerary-editor-head">
              <div>
                <span class="form-label" id="itinerary-title">
                  Itinerary inti perjalanan
                </span>
                <small class="field-note">
                  Itinerary yang dialami semua peserta setelah perjalanan
                  dimulai. Muncul satu kali di halaman detail trip dan menjadi
                  dasar rundown peserta. Satu kartu = satu hari atau tahap;
                  bukan daftar per baris kegiatan.
                </small>
              </div>
              <button
                class="link-button"
                id="add-itinerary-stage"
                type="button"
              >
                + Tambah tahap
              </button>
            </div>
            <div id="itinerary-stages" class="itinerary-stages"></div>
            <p class="empty itinerary-empty" id="itinerary-empty">
              Belum ada tahap. Tambahkan agar peserta memahami alur perjalanan.
            </p>
          </div>
          <p class="field-note itinerary-meeting-point-note">
            Lokasi meeting point dikelola pada bagian{' '}
            <strong>Titik jemput</strong>. Setelah jadwal dibuat, pilih titik
            yang aktif lalu tentukan harga dan rundownnya.
          </p>
        </details>
        <details>
          <summary>05 · Persiapan & ketentuan peserta</summary>
          <label>
            Persiapan{' '}
            <textarea name="preparation" maxlength="12000" rows="3"></textarea>
          </label>
          <label>
            Ketentuan{' '}
            <textarea name="terms" maxlength="16000" rows="4"></textarea>
          </label>
        </details>
        {tripId && (
          <label class="version-propagation-option">
            <input type="checkbox" name="applyToUnbookedDepartures" checked />
            <span>
              <strong>Terapkan ke jadwal tanpa booking</strong>
              <small>
                Jadwal yang sudah memiliki booking tetap memakai versi lama agar
                data peserta tidak berubah.
              </small>
            </span>
          </label>
        )}
        <button class="primary" type="submit">
          Simpan trip
        </button>
      </form>
    </section>

    {tripId && (
      <section
        class="panel pickup-master-panel"
        aria-labelledby="pickup-master-title"
        id="pickup-master-editor"
        hidden
      >
        <div class="panel-head">
          <div>
            <p class="eyebrow">02 / TITIK JEMPUT</p>
            <h2 id="pickup-master-title">Lokasi tersimpan</h2>
            <p class="muted">
              Lokasi disimpan sekali untuk paket ini. Harga dan rundown khusus
              baru ditentukan pada tiap jadwal.
            </p>
          </div>
          <button type="button" class="primary" id="add-pickup-master">
            + Tambah lokasi
          </button>
        </div>
        <div class="pickup-master-workspace">
          <div class="pickup-master-library">
            <span class="muted" id="pickup-master-count">
              Memuat lokasi…
            </span>
            <div id="pickup-master-list" class="pickup-master-list"></div>
          </div>
          <form id="pickup-master-form" class="pickup-master-form" hidden>
            <div class="subsection-heading">
              <strong id="pickup-form-title">Tambah lokasi</strong>
              <span>Isi alamat tetapnya; jam jemput tidak perlu di sini.</span>
            </div>
            <input name="id" type="hidden" />
            <div class="form-two-columns">
              <label>
                Lokasi meeting point
                <input
                  name="zoneName"
                  maxlength="120"
                  required
                  placeholder="Contoh: Jakarta"
                />
              </label>
              <label>
                Nama lokasi
                <input
                  name="locationName"
                  maxlength="160"
                  required
                  placeholder="Contoh: Halim Perdanakusuma"
                />
              </label>
            </div>
            <label>
              Alamat
              <textarea
                name="address"
                maxlength="1000"
                rows="2"
                required
              ></textarea>
            </label>
            <label>
              Tautan Google Maps <small>Opsional</small>
              <input
                name="mapsUrl"
                type="url"
                maxlength="2000"
                placeholder="https://maps.google.com/..."
              />
            </label>
            <label>
              Petunjuk dasar <small>Opsional</small>
              <textarea
                name="instructions"
                maxlength="2000"
                rows="2"
                placeholder="Patokan lokasi atau informasi yang jarang berubah."
              ></textarea>
            </label>
            <div class="pickup-master-actions">
              <button
                id="cancel-pickup-master"
                class="button-link"
                type="button"
              >
                Tutup form
              </button>
              <button class="primary" type="submit">
                Simpan lokasi ↗
              </button>
            </div>
          </form>
        </div>
      </section>
    )}

    <section
      class="panel list-panel schedule-overview-panel"
      aria-labelledby="trip-list-title"
      id="schedule-list-panel"
      hidden={!tripId}
    >
      <div class="panel-head">
        <div>
          <h2 id="trip-list-title">Jadwal tersimpan</h2>
          <p class="muted">
            Pilih jadwal untuk mengelola meeting point, peserta, dan keuangan.
          </p>
        </div>
        <div class="schedule-overview-actions">
          <span id="loading">Memuat…</span>
          <button type="button" class="primary" id="add-departure">
            + Tambah jadwal
          </button>
        </div>
      </div>
      <div id="trip-list" class="trip-list"></div>
    </section>

    <section
      class="panel departure-editor-panel"
      aria-labelledby="departure-form-title"
      id="departure-editor"
      hidden
    >
      <div class="panel-head">
        <div>
          <h2 id="departure-form-title">Buat jadwal</h2>
        </div>
        <button class="link-button" type="button" id="new-departure" hidden>
          Kembali ke daftar
        </button>
      </div>
      <p class="muted">
        Atur keberangkatan dan kuota. Jadwal memakai versi paket yang terkunci;
        meeting point hanya menyimpan detail penjemputan.
      </p>
      <form id="departure-form">
        <input type="hidden" name="id" />
        <label hidden>
          Trip{' '}
          <select name="tripId" required id="departure-trip">
            <option value="">Pilih trip dahulu</option>
          </select>
        </label>
        <div class="departure-form-grid">
          <fieldset class="date-fieldset schedule-form-card">
            <legend>Waktu & kuota · WIB</legend>
            <input type="hidden" name="timezone" value="Asia/Jakarta" />
            <div class="two-col date-time-grid">
              <label>
                Tanggal mulai <input type="date" name="startDate" required />
              </label>
              <label>
                Jam mulai
                <input type="time" name="startTime" step="60" required />
              </label>
              <label>
                Tanggal selesai <input type="date" name="endDate" required />
              </label>
              <label>
                Jam selesai
                <input type="time" name="endTime" step="60" required />
              </label>
            </div>
            <p
              class="date-summary"
              id="trip-duration-summary"
              aria-live="polite"
            >
              Pilih tanggal mulai untuk menghitung durasi.
            </p>
            <label>
              Kuota total
              <input
                type="number"
                name="capacity"
                min="1"
                max="10000"
                step="1"
                required
                placeholder="20"
              />
              <small>Total kursi untuk seluruh meeting point.</small>
            </label>
          </fieldset>

          <fieldset
            class="date-fieldset schedule-form-card"
            id="initial-pickup-fields"
          >
            <legend>Meeting point pertama</legend>
            <label>
              Pilih lokasi tersimpan
              <select name="initialPickupPointId" required>
                <option value="">Memuat lokasi…</option>
              </select>
            </label>
            <p class="field-note" id="initial-pickup-address">
              Alamat mengikuti lokasi tersimpan. Rundown pickup bersifat
              opsional dan diatur setelah jadwal dibuat.
            </p>
            <button type="button" class="link-button" id="go-to-pickups" hidden>
              Tambahkan lokasi di Titik jemput
            </button>
            <label>
              Harga meeting point / pax
              <input
                type="text"
                name="unitPrice"
                inputmode="numeric"
                autocomplete="off"
                required
                placeholder="Rp2.500.000"
              />
              <small>
                Langsung menjadi harga jual lokasi ini. Tambah lokasi lain
                melalui Kelola jadwal.
              </small>
            </label>
          </fieldset>
        </div>
        <p class="policy" id="existing-pickup-note" hidden>
          Harga mengikuti meeting point yang sudah tersimpan. Ubah melalui
          Kelola jadwal.
        </p>
        <details id="schedule-payment-settings" class="schedule-settings">
          <summary>
            Aturan pembayaran & publikasi{' '}
            <span id="schedule-policy-summary">DP 30% · Draft</span>
          </summary>
          <div class="departure-form-grid">
            <fieldset class="date-fieldset schedule-form-card">
              <legend>Down payment & status</legend>
              <div class="two-col">
                <label>
                  Down payment
                  <select name="dpMode">
                    <option value="percent">Persentase</option>
                    <option value="amount">Nominal</option>
                  </select>
                </label>
                <label>
                  Nilai down payment
                  <input
                    type="text"
                    name="dpValue"
                    inputmode="numeric"
                    autocomplete="off"
                    required
                    placeholder="30"
                    value="30"
                  />
                </label>
              </div>
              <small>DP dihitung dari total pesanan.</small>
              <label>
                Status jadwal
                <select name="publicationState">
                  <option value="draft">Draft — belum tampil</option>
                  <option value="open">Buka — bisa dipesan</option>
                  <option value="closed">Tutup — hentikan pesanan</option>
                </select>
              </label>
            </fieldset>

            <fieldset class="date-fieldset schedule-form-card">
              <legend>Tenggat · WIB</legend>
              <div class="two-col date-time-grid">
                <label>
                  Tutup booking
                  <input type="date" name="bookingCutoffDate" required />
                </label>
                <label>
                  Jam tutup
                  <input
                    type="time"
                    name="bookingCutoffTime"
                    step="60"
                    required
                  />
                </label>
                <label>
                  Tenggat pelunasan <input type="date" name="balanceDueDate" />
                </label>
                <label>
                  Jam pelunasan
                  <input type="time" name="balanceDueTime" step="60" />
                </label>
              </div>
              <p class="date-summary" id="deadline-summary" aria-live="polite">
                Pilih tanggal mulai untuk menyiapkan tenggat.
              </p>
              <small>
                Pelunasan boleh dikosongkan. Batas paling akhir adalah hari
                terakhir trip (hari turun).
              </small>
            </fieldset>
          </div>
        </details>
        <details id="schedule-itinerary-settings" class="schedule-settings">
          <summary>
            Itinerary & versi paket{' '}
            <span id="schedule-version-summary">Versi terbaru</span>
          </summary>
          <div class="schedule-form-card">
            <p class="field-note" id="schedule-version-note">
              Jadwal baru memakai versi paket terbaru.
            </p>
            <label id="latest-version-option" hidden>
              <span>
                <input type="checkbox" name="useLatestTripVersion" />
                Pindahkan jadwal ini ke versi paket terbaru
              </span>
              <small>
                Aksi ini eksplisit. Jadwal lama tetap memakai versinya sampai
                pilihan ini dicentang.
              </small>
            </label>
            <label>
              <span>
                <input type="checkbox" name="useItineraryOverride" />
                Gunakan itinerary khusus jadwal ini
              </span>
              <small>
                Kosong berarti mengikuti itinerary inti versi paket. Override
                hanya untuk jadwal dengan rute penuh yang benar-benar berbeda.
              </small>
            </label>
            <input name="itineraryOverride" type="hidden" value="[]" />
            <div id="schedule-itinerary-editor" class="itinerary-editor" hidden>
              <div class="itinerary-editor-head">
                <div>
                  <span class="form-label">Itinerary khusus jadwal</span>
                  <small class="field-note">
                    Disimpan sebagai pengganti itinerary inti hanya untuk
                    keberangkatan ini.
                  </small>
                </div>
                <button
                  class="link-button"
                  id="add-schedule-itinerary-stage"
                  type="button"
                >
                  + Tambah tahap
                </button>
              </div>
              <div
                id="schedule-itinerary-stages"
                class="itinerary-stages"
              ></div>
              <p class="empty itinerary-empty" id="schedule-itinerary-empty">
                Belum ada tahap. Salin itinerary inti atau tambah tahap.
              </p>
              <button
                type="button"
                class="button-link"
                id="copy-core-itinerary"
              >
                Salin itinerary inti sebagai titik awal
              </button>
            </div>
          </div>
        </details>
        <div class="departure-submit-bar">
          <div>
            <strong id="schedule-save-hint">
              Lokasi dan harga tersimpan bersama jadwal.
            </strong>
            <span>Periksa tanggal serta kuota sebelum menyimpan.</span>
          </div>
          <button class="primary" type="submit">
            Simpan jadwal
          </button>
        </div>
      </form>
    </section>
  </div>

  <script is:inline>
    const editorTripId = document.getElementById('trip-editor').dataset.tripId;
    const tripForm = document.getElementById('trip-form');
    const departureForm = document.getElementById('departure-form');
