        input.value = value;
        input.placeholder = options.placeholder || '';
        if (options.required) input.required = true;
        input.addEventListener('input', () => {
          if (activityIndex === null) stages[stageIndex][key] = input.value;
          else stages[stageIndex].activities[activityIndex][key] = input.value;
          sync();
        });
        label.append(input);
        return label;
