        ['trekDurationMaxHours', 'trekDurationMaxMinutes'],
      ]) {
        const rawHours = String(data[hoursField] || '').trim();
        data[minutesField] = rawHours
          ? String(Math.round(Number(rawHours) * 60))
          : '';
