    function cleanItineraryStage(value = {}) {
      const oldActivity = value.activity
        ? [
            {
              time: value.time || '',
              activity: value.activity,
              location: value.location || '',
            },
          ]
        : [];
      return {
        day: String(value.day || value.stage || ''),
        title: String(value.title || value.activity || ''),
        activities:
          Array.isArray(value.activities) && value.activities.length
            ? value.activities.map((item) => ({
                time: String(item.time || ''),
                activity: String(item.activity || ''),
                location: String(item.location || ''),
              }))
            : oldActivity,
        details: String(value.details || ''),
      };
    }
    function legacyItineraryStages(value) {
      const lines = String(value || '')
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean);
      const output = [];
      for (const line of lines) {
        const heading = line.match(/^(Hari\s*\d+|Tahap\s*\d+)\s*[—-]\s*(.+)$/i);
        if (heading)
          output.push(
            cleanItineraryStage({
              day: heading[1],
              title: heading[2],
              activities: [{ activity: heading[2] }],
            }),
          );
        else if (output.length)
          output[output.length - 1].details = [
            output[output.length - 1].details,
            line,
          ]
            .filter(Boolean)
            .join(' ');
      }
      return output;
    }
    function renderStageEditor(stages, element, empty, hiddenField) {
