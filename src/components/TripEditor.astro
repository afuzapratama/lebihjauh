    async function loadPickupMasters() {
      if (!editorTripId || !pickupMasterList) return;
      try {
        const response = await fetch(
          `/api/admin/trips/${editorTripId}/pickup-points`,
        );
        const result = await response.json();
        if (!response.ok) throw new Error(result.message);
        if (!Array.isArray(result.pickupPoints))
          throw new Error(
            'Lokasi belum dapat dimuat. Muat ulang halaman untuk mencoba lagi.',
          );
        pickupMasters = result.pickupPoints;
        renderPickupMasters();
      } catch (error) {
        if (pickupMasterCount)
          pickupMasterCount.textContent = 'Gagal memuat lokasi';
        showNotice(error.message || 'Titik jemput gagal dimuat.', 'error');
      }
    }
    function wibParts(date) {
      if (!date) return { date: '', time: '' };
      const value = new Date(date);
      if (Number.isNaN(value.valueOf())) return { date: '', time: '' };
      const wib = new Date(value.valueOf() + 7 * 3600000).toISOString();
      return { date: wib.slice(0, 10), time: wib.slice(11, 16) };
    }
    function setTimeOptions(select, selected = '') {
      select.value = selected;
    }
    function addDays(date, days) {
      if (!date) return '';
      const [year, month, day] = date.split('-').map(Number);
      const value = new Date(Date.UTC(year, month - 1, day + days));
      return value.toISOString().slice(0, 10);
    }
    function slugify(value) {
      return value
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');
    }
    function syncSlug() {
      const slug = slugify(tripForm.elements.name.value);
      tripForm.elements.slug.value = slug;
      slugPreview.textContent = slug ? `/trip/${slug}` : '/trip/—';
    }
    function syncCategory(customValue = '') {
      const isCustom = categorySelect.value === '__custom';
      customCategoryField.hidden = !isCustom;
      customCategoryInput.required = isCustom;
      if (isCustom) customCategoryInput.value = customValue;
    }
    function setCategory(value) {
      const isKnown = Array.from(categorySelect.options).some(
        (option) => option.value === value && value !== '__custom',
      );
      categorySelect.value = isKnown ? value : '__custom';
      syncCategory(isKnown ? '' : value);
    }
    function dateLabel(date) {
      return new Intl.DateTimeFormat('id-ID', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      }).format(new Date(`${date}T00:00:00Z`));
    }
    function syncScheduleSummary() {
      syncPolicySummary();
      const startDate = departureForm.elements.startDate.value;
      const endDate = departureForm.elements.endDate.value;
      if (!startDate) {
        departureForm.elements.endDate.min = '';
        departureForm.elements.bookingCutoffDate.max = '';
        departureForm.elements.balanceDueDate.max = '';
        tripDurationSummary.textContent =
          'Pilih tanggal mulai untuk menghitung durasi.';
        deadlineSummary.textContent =
          'Pilih tanggal mulai untuk menyiapkan tenggat.';
        return;
      }
      departureForm.elements.endDate.min = startDate;
      departureForm.elements.bookingCutoffDate.max = startDate;
      departureForm.elements.balanceDueDate.max = endDate || startDate;
      if (endDate) {
        const length =
          Math.round(
            (Date.parse(`${endDate}T00:00:00Z`) -
              Date.parse(`${startDate}T00:00:00Z`)) /
              86_400_000,
          ) + 1;
        tripDurationSummary.textContent =
          length > 0
            ? `Perjalanan: ${length} hari · ${dateLabel(startDate)}–${dateLabel(endDate)}.`
            : 'Tanggal selesai perlu setelah tanggal mulai.';
      }
      const cutoff = departureForm.elements.bookingCutoffDate.value;
      const balance = departureForm.elements.balanceDueDate.value;
      deadlineSummary.textContent = [
        cutoff ? `Booking: ${dateLabel(cutoff)}` : 'Booking belum diatur',
        balance ? `Pelunasan: ${dateLabel(balance)}` : 'Pelunasan opsional',
      ].join(' · ');
    }
    function applyDuration(days = selectedDurationDays) {
      const startDate = departureForm.elements.startDate.value;
      if (!startDate) return;
      selectedDurationDays = days;
      departureForm.elements.endDate.value = addDays(startDate, days - 1);
      departureForm.elements.endTime.value = '17:00';
      if (days === 1 && departureForm.elements.startTime.value >= '17:00') {
        const finish = wibParts(
          new Date(
            new Date(
              `${startDate}T${departureForm.elements.startTime.value}:00+07:00`,
            ).getTime() + 3600000,
          ),
        );
        departureForm.elements.endDate.value = finish.date;
        departureForm.elements.endTime.value = finish.time;
      }
      endIsAutomatic = true;
    }
    function applyCutoff(days = 1) {
      const startDate = departureForm.elements.startDate.value;
      if (!startDate) return;
      departureForm.elements.bookingCutoffDate.value = addDays(
