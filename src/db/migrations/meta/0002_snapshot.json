      "checkConstraints": {
        "departures_date_range_check": {
          "name": "departures_date_range_check",
          "value": "\"departures\".\"start_at\" < \"departures\".\"end_at\""
        },
        "departures_capacity_check": {
          "name": "departures_capacity_check",
          "value": "\"departures\".\"capacity\" >= 0"
        },
        "departures_price_check": {
          "name": "departures_price_check",
          "value": "\"departures\".\"unit_price\" > 0"
        },
        "departures_dp_mode_check": {
          "name": "departures_dp_mode_check",
          "value": "\"departures\".\"dp_mode\" in ('percent', 'amount')"
        },
        "departures_dp_value_check": {
          "name": "departures_dp_value_check",
          "value": "\"departures\".\"dp_value\" >= 0"
        },
        "departures_dp_percent_check": {
          "name": "departures_dp_percent_check",
          "value": "\"departures\".\"dp_mode\" <> 'percent' or \"departures\".\"dp_value\" <= 100"
        },
        "departures_state_check": {
          "name": "departures_state_check",
          "value": "\"departures\".\"publication_state\" in ('draft', 'open', 'closed')"
        },
        "departures_cutoff_check": {
          "name": "departures_cutoff_check",
          "value": "\"departures\".\"booking_cutoff_at\" <= \"departures\".\"start_at\""
        }
