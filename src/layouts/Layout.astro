---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '@fontsource/caveat/latin-700.css';
import '../styles/global.css';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { whatsappUrl } from '../lib/contact-settings';
import { getSitePageContent } from '../lib/site-content';
import {
  activeSocialLinks,
  type SocialIconName,
} from '../lib/social-platforms';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  robots?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = 'LebihJauh — Pergi jauh. Pulang lebih hidup.',
  description = 'LebihJauh. Ruang untuk perjalanan, teman baru, dan cerita yang dibawa pulang. Jelajahi inspirasi open trip gunung dan rencanakan private trip-mu.',
  image,
  canonical,
  type = 'website',
  publishedTime,
  modifiedTime,
  robots = 'index, follow',
  jsonLd,
} = Astro.props;
const siteOrigin =
  process.env.PUBLIC_SITE_URL ??
  process.env.BETTER_AUTH_URL ??
  Astro.url.origin;
const canonicalUrl = new URL(
  canonical ?? Astro.url.pathname,
  siteOrigin,
).toString();
const shareImage = image ? new URL(image, siteOrigin).toString() : undefined;
const structuredData = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, '\\u003c')
  : '';
const isGlobalDraftPreview =
  ['draft', 'global'].includes(Astro.url.searchParams.get('preview') ?? '') &&
  Boolean(Astro.locals.user);
const globalSettings = await getSitePageContent('global', isGlobalDraftPreview);
const whatsappHref = whatsappUrl(
  globalSettings.contact.whatsappNumber,
  globalSettings.contact.whatsappGreeting,
);
const socialLinks: Array<{
  key: SocialIconName;
  label: string;
  href: string;
}> = activeSocialLinks(globalSettings.socials).map(({ key, label, href }) => ({
  key,
  label,
  href,
}));
if (whatsappHref) {
  const telegramIndex = socialLinks.findIndex(({ key }) => key === 'telegram');
  socialLinks.splice(
    telegramIndex < 0 ? socialLinks.length : telegramIndex,
    0,
    {
      key: 'whatsapp',
      label: 'WhatsApp',
      href: whatsappHref,
    },
  );
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5f0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="LebihJauh" />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta property="og:type" content={type} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    <meta
      name="twitter:card"
      content={shareImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    <meta name="robots" content={robots} />
    {structuredData && (
      <script
        type="application/ld+json"
        is:inline
        set:html={structuredData}
      ></script>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Langsung ke konten
    </a>
    <slot />
    <SiteFooter socialLinks={socialLinks} />
    <FloatingWhatsApp href={whatsappHref} />
    <script>
      import '../scripts/navigation';
    </script>
  </body>
</html>
