---
export const prerender = false;

const routes = {
  'gunung-ungaran-demo': {
    name: 'Gunung Ungaran via Basecamp Mawar',
    note: 'Simulasi tampilan — bukan track navigasi resmi',
    start: {
      name: 'Mulai · Basecamp Mawar',
      coordinates: [110.3650511, -7.19368],
    },
    finish: {
      name: 'Puncak Ungaran',
      coordinates: [110.3470896, -7.1856195],
    },
    coordinates: [
      [110.3650511, -7.19368],
      [110.3636, -7.1931],
      [110.3628, -7.1927],
      [110.3615, -7.1921],
      [110.3603, -7.1914],
      [110.3592, -7.1907],
      [110.3579, -7.1899],
      [110.3568, -7.189],
      [110.3558, -7.1882],
      [110.3546, -7.1873],
      [110.3534, -7.1866],
      [110.3521, -7.186],
      [110.3508, -7.1855],
      [110.3493, -7.1853],
      [110.3470896, -7.1856195],
    ],
  },
} as const;

const route = routes[Astro.params.slug as keyof typeof routes];
if (!route) Astro.response.status = 404;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{route ? `Peta ${route.name}` : 'Peta tidak ditemukan'}</title>
  </head>
  <body>
    {route ? (
      <main
        id="trail-map"
        data-route={JSON.stringify(route)}
        aria-label={`Peta demo ${route.name}`}
      >
        <div class="map-status">
          <strong>SIMULASI TAMPILAN</strong>
          <span>Bukan panduan navigasi</span>
        </div>
        <p class="map-loading" role="status">
          Memuat peta jalur…
        </p>
      </main>
    ) : (
      <main class="map-empty">
        <strong>Peta tidak ditemukan.</strong>
      </main>
    )}
    <script>
      import {
        LngLatBounds,
        Map,
        Marker,
        NavigationControl,
        ScaleControl,
        setWorkerUrl,
      } from 'maplibre-gl';
      import 'maplibre-gl/dist/maplibre-gl.css';
      import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';

      setWorkerUrl(workerUrl);

      const container = document.querySelector<HTMLElement>('#trail-map');
      if (container?.dataset.route) {
        const route = JSON.parse(container.dataset.route);
        const map = new Map({
          container,
          style: 'https://tiles.openfreemap.org/styles/liberty',
          center: route.start.coordinates,
          zoom: 13,
        });

        map.addControl(
          new NavigationControl({ showCompass: true, visualizePitch: true }),
          'top-right',
        );
        map.addControl(new ScaleControl({ unit: 'metric' }), 'bottom-left');

        const addMarker = (
          point: { name: string; coordinates: [number, number] },
          kind: 'start' | 'finish',
        ) => {
          const element = document.createElement('div');
          element.className = `route-marker route-marker-${kind}`;
          const dot = document.createElement('span');
          dot.setAttribute('aria-hidden', 'true');
          const label = document.createElement('strong');
          label.textContent = point.name;
          element.append(dot, label);
          new Marker({ element, anchor: 'bottom' })
            .setLngLat(point.coordinates)
            .addTo(map);
        };

        map.on('load', () => {
          map.addSource('demo-route', {
            type: 'geojson',
            data: {
              type: 'Feature',
              properties: {},
              geometry: {
                type: 'LineString',
                coordinates: route.coordinates,
              },
            },
          });
          map.addLayer({
            id: 'demo-route-shadow',
            type: 'line',
            source: 'demo-route',
            layout: { 'line-cap': 'round', 'line-join': 'round' },
            paint: {
              'line-color': '#fffef9',
              'line-width': 9,
              'line-opacity': 0.92,
            },
          });
          map.addLayer({
            id: 'demo-route-line',
            type: 'line',
            source: 'demo-route',
            layout: { 'line-cap': 'round', 'line-join': 'round' },
            paint: { 'line-color': '#e15d26', 'line-width': 5 },
          });
          addMarker(route.start, 'start');
          addMarker(route.finish, 'finish');

          const bounds = new LngLatBounds();
          route.coordinates.forEach((coordinate: [number, number]) =>
            bounds.extend(coordinate),
          );
          map.fitBounds(bounds, {
            padding: { top: 82, right: 64, bottom: 70, left: 64 },
            maxZoom: 15,
            duration: 0,
          });
          container.querySelector('.map-loading')?.remove();
        });
      }
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html,
  body,
  #trail-map,
  .map-empty {
    width: 100%;
    height: 100%;
    min-height: 100vh;
    margin: 0;
  }
  body {
    overflow: hidden;
    background: #e8e9e2;
    color: #191b18;
    font-family: Inter, Arial, sans-serif;
  }
  #trail-map {
    position: relative;
  }
  .map-status {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    display: grid;
    gap: 3px;
    padding: 10px 12px;
    border-left: 4px solid #e15d26;
    background: rgb(255 254 249 / 94%);
    box-shadow: 0 8px 24px rgb(25 27 24 / 16%);
    backdrop-filter: blur(10px);
  }
  .map-status strong {
    font-size: 10px;
    letter-spacing: 1.1px;
  }
  .map-status span {
    color: #62685d;
    font-size: 9px;
  }
  .map-loading,
  .map-empty {
    display: grid;
    place-items: center;
    color: #62685d;
    font-size: 12px;
  }
  .maplibregl-ctrl-group {
    border-radius: 2px;
  }
  .route-marker {
    position: relative;
    display: grid;
    justify-items: center;
    color: #191b18;
  }
  .route-marker > span {
    width: 20px;
    height: 20px;
    border: 4px solid #fffef9;
    border-radius: 50% 50% 50% 0;
    background: #3c4936;
    box-shadow: 0 3px 10px rgb(25 27 24 / 30%);
    transform: rotate(-45deg);
  }
  .route-marker-finish > span {
    background: #e15d26;
  }
  .route-marker strong {
    position: absolute;
    bottom: 27px;
    width: max-content;
    max-width: 150px;
    padding: 6px 8px;
    border: 1px solid rgb(25 27 24 / 14%);
    background: rgb(255 254 249 / 96%);
    box-shadow: 0 5px 15px rgb(25 27 24 / 14%);
    font-size: 10px;
    line-height: 1.3;
    text-align: center;
  }
  .route-marker-finish strong {
    top: 27px;
    bottom: auto;
  }
  @media (max-width: 480px) {
    .map-status {
      top: 10px;
      left: 10px;
    }
    .route-marker strong {
      max-width: 112px;
      font-size: 9px;
    }
  }
</style>
